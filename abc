-- 2. ปุ่มเปิด/ปิดเพลง
local MusicBtn = createButton(UDim2.new(0, 20, 0, 100), "🎵 เปิดเพลง [OFF]")
local MusicPlaying = false

MusicBtn.MouseButton1Click:Connect(function()
    MusicPlaying = not MusicPlaying
    if MusicPlaying then
        if Sound.SoundId ~= "" and Sound.SoundId ~= "rbxassetid://" then
            Sound:Play()
            MusicBtn.Text = "🎵 ปิดเพลง [ON]"
            MusicBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        else
            MusicPlaying = false
            MusicBtn.Text = "⚠️️ กรุณาใส่ ID เพลงก่อน!"
            task.wait(1.5)
            MusicBtn.Text = "🎵 เปิดเพลง [OFF]"
        end
    else
        Sound:Stop()
        MusicBtn.Text = "🎵 เปิดเพลง [OFF]"
        MusicBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    end
end)

-- 3. ระบบบิน (รองรับมือถือและคอม)
local FlyBtn = createButton(UDim2.new(0, 20, 0, 150), "✈️ บินอิสระ [OFF]")
local Flying = false
local flySpeed = 50
local bg, bv

-- ปุ่มจำลองบนหน้าจอสำหรับมือถือ (ขึ้น / ลง)
local UpBtn = Instance.new("TextButton")
UpBtn.Size = UDim2.new(0, 60, 0, 40)
UpBtn.Position = UDim2.new(1, -70, 0.5, -50)
UpBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
UpBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
UpBtn.Text = "ขึ้น ⬆️"
UpBtn.Visible = false
UpBtn.Parent = ScreenGui

local DownBtn = Instance.new("TextButton")
DownBtn.Size = UDim2.new(0, 60, 0, 40)
DownBtn.Position = UDim2.new(1, -70, 0.5, 10)
DownBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
DownBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
DownBtn.Text = "ลง ⬇️"
DownBtn.Visible = false
DownBtn.Parent = ScreenGui

local movingUp, movingDown = false, false
UpBtn.MouseButton1Down:Connect(function() movingUp = true end)
UpBtn.MouseButton1Up:Connect(function() movingUp = false end)
DownBtn.MouseButton1Down:Connect(function() movingDown = true end)
DownBtn.MouseButton1Up:Connect(function() movingDown = false end)

FlyBtn.MouseButton1Click:Connect(function()
    Flying = not Flying
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    UpBtn.Visible = Flying
    DownBtn.Visible = Flying
    
    if Flying then
        FlyBtn.Text = "✈️ บินอิสระ [ON]"
        FlyBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        
        local hrp = char.HumanoidRootPart
        bg = Instance.new("BodyGyro", hrp)
        bg.P = 9e4
        bg.maxTorque = Vector3.new(9e4, 9e4, 9e4)
        
        bv = Instance.new("BodyVelocity", hrp)
        bv.velocity = Vector3.new(0, 0, 0)
        bv.maxForce = Vector3.new(9e4, 9e4, 9e4)
        
        task.spawn(function()
            while Flying and char and char:FindFirstChild("HumanoidRootPart") do
                local cam = workspace.CurrentCamera
                local moveDir = Vector3.new(0,0,0)
                
                local humanoid = char:FindFirstChildOfClass("Humanoid")
                if humanoid and humanoid.MoveDirection.Magnitude > 0 then
                    moveDir = humanoid.MoveDirection
                end
                
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + cam.CoordinateFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - cam.CoordinateFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - cam.CoordinateFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + cam.CoordinateFrame.RightVector end
                
                local upVector = Vector3.new(0,0,0)
                if movingUp or UserInputService:IsKeyDown(Enum.KeyCode.Space) then upVector = Vector3.new(0, 1, 0) end
                if movingDown or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then upVector = Vector3.new(0, -1, 0) end
                
                bv.velocity = (moveDir * flySpeed) + (upVector * flySpeed)
                bg.cframe = cam.CoordinateFrame
                task.wait()
            end
        end)
    else
        FlyBtn.Text = "✈️ บินอิสระ [OFF]"
        FlyBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        if bg then bg:Destroy() end
        if bv then bv:Destroy() end
    end
end)

-- 4. ทะลุกำแพง (Noclip)
local NoclipBtn = createButton(UDim2.new(0, 20, 0, 200), "👻 ทะลุกำแพง [OFF]")
local Noclips = false
local noclipConnection

NoclipBtn.MouseButton1Click:Connect(function()
    Noclips = not Noclips
    if Noclips then
        NoclipBtn.Text = "👻 ทะลุกำแพง [ON]"
        NoclipBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        noclipConnection = RunService.Stepped:Connect(function()
            local char = LocalPlayer.Character
            if char then
                for _, part in pairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end)
    else
        NoclipBtn.Text = "👻 ทะลุกำแพง [OFF]"
        NoclipBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        if noclipConnection then
            noclipConnection:Disconnect()
        end
    end
end)

